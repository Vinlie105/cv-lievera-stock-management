# Copy to .env (never commit .env) and replace every value. Generate secrets on the server:
#   openssl rand -base64 24    -> DB_PASSWORD, BACKUP_PASSPHRASE
#   openssl rand -base64 48    -> JWT_SECRET
#   openssl rand -base64 32    -> APP_ENCRYPTION_KEY   (must be exactly 32 bytes, base64)

# Public hostname that points at this server, e.g. cvlievera.duckdns.org
DOMAIN=stock.example.com

DB_USERNAME=cv_lievera_user
DB_PASSWORD=change-me

JWT_SECRET=change-me-at-least-32-characters-long
APP_ENCRYPTION_KEY=change-me-32-bytes-base64

# First-run admin password (12+ chars, 3 of 4 character types). The admin must change it at first login.
# Remove this line from .env after the first successful login.
BOOTSTRAP_ADMIN_PASSWORD=

# Encrypts nightly database backups (scripts/backup.sh). Store a copy of this somewhere safe: without it backups are useless.
BACKUP_PASSPHRASE=change-me
